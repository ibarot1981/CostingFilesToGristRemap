GRIST_BASE_URL=https://docs.getgrist.com
GRIST_DOC_ID=your-grist-doc-id
GRIST_API_KEY=your-grist-api-key

# Safari Manufacturing uses a separate Grist document. Its setup command will
# discover/create the document in the explicitly selected workspace and return
# the document ID. Never point this at the legacy Costing-New document.
SAFARI_MANUFACTURING_GRIST_WORKSPACE_ID=your-writable-workspace-id
SAFARI_MANUFACTURING_GRIST_DOC_ID=created-safari-manufacturing-doc-id
SAFARI_REPOSITORY=memory
COSTING_ROOT=C:\Irshad\Safari\DRWGD\Products Costing
CATALOG_ODS_PATH=C:\path\Product-ProductModelNo-ModelCode.ods
DXF_ROOT_PATH=C:\Path\To\Nesting\DXF
